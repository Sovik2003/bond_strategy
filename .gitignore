# Секреты и окружение
.env
.env.*
!.env.example
*.pem
*.key

# Сырые ответы ISS: 78 МБ, воспроизводимы повторной загрузкой
data/raw/
data/backups/
# Кэш обогащения выпусков: воспроизводится повторной загрузкой
data/cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Тесты и кэш
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Локальная база и выгрузки
*.db
*.sqlite3
data/exports/*.json
!data/exports/.gitkeep

# Отчёты Streamlit-витрины (генерируются приложением)
data/reports/

# Редакторы и ОС
.vscode/
.idea/
.DS_Store

# Manually entered holdings are private local data
data/portfolio.json
data/.portfolio-*.tmp
